{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", ":dependencyDashboard"],
  "timezone": "Europe/Berlin",
  "rangeStrategy": "bump",
  "prHourlyLimit": 2,
  "prConcurrentLimit": 5,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "groupName": null,
    "schedule": [],
    "dependencyDashboardApproval": false,
    "minimumReleaseAge": null,
    "prCreation": "immediate",
    "labels": ["security", "dependencies"],
    "automerge": false,
    "vulnerabilityFixStrategy": "lowest",
    "prConcurrentLimit": 0,
    "semanticCommitType": "fix",
    "prBodyNotes": [
      "Security fix: review the advisory and CI results before merging. Major upgrades may be required."
    ]
  },
  "packageRules": [
    {
      "description": "Wait a bit before adopting fresh npm releases",
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "3 days",
      "schedule": ["* * * * 1"]
    },
    {
      "description": "Group remaining npm patch/minor updates; specific families below override this group",
      "groupName": "npm Dependencies",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "description": "Monthly major upgrades; allow PRs without dashboard approval by default",
      "matchUpdateTypes": ["major"],
      "groupName": null,
      "schedule": ["* * 1-3 * *"],
      "minimumReleaseAge": "7 days",
      "prPriority": -2,
      "addLabels": ["major"],
      "prBodyNotes": ["Major update: inspect release notes and migration guides for breaking changes before merging."]
    },
    {
      "description": "Group remaining npm runtime majors; specific families below take precedence",
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["major"],
      "groupName": "npm Runtime Major Updates"
    },
    {
      "description": "Group remaining npm development majors; specific families below take precedence",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["major"],
      "groupName": "npm Development Major Updates"
    },
    {
      "description": "Prioritize regular patches over minor and major updates",
      "matchUpdateTypes": ["patch"],
      "prPriority": 2,
      "addLabels": ["patch"]
    },
    {
      "description": "Regular minor updates remain separate from patches",
      "matchUpdateTypes": ["minor"],
      "prPriority": 1,
      "addLabels": ["minor"]
    },
    {
      "description": "Keep Next.js, React, and matching types/config together",
      "groupName": "Next.js Core",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "next",
        "react",
        "react-dom",
        "eslint-config-next",
        "@types/react",
        "@types/react-dom"
      ]
    },
    {
      "description": "Prisma packages should be reviewed and tested together",
      "groupName": "Prisma Database",
      "matchManagers": ["npm"],
      "matchPackageNames": ["prisma", "@prisma/client", "@prisma/adapter-*", "@prisma/extension-*"]
    },
    {
      "description": "Stripe SDK packages should be updated together",
      "groupName": "Stripe",
      "matchManagers": ["npm"],
      "matchPackageNames": ["stripe", "@stripe/**"]
    },
    {
      "description": "Group better-auth packages",
      "groupName": "Better Auth",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "better-auth",
        "@better-auth/**"
      ]
    },
    {
      "description": "Group Material UI and Emotion",
      "groupName": "MUI System",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "@mui/**",
        "@emotion/**"
      ]
    },
    {
      "description": "Group FullCalendar packages",
      "groupName": "FullCalendar",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@fullcalendar/**"]
    },
    {
      "description": "Group DnD Kit packages",
      "groupName": "DnD Kit",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@dnd-kit/**"]
    },
    {
      "description": "Group testing tools",
      "groupName": "Testing Suite",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "vitest",
        "jsdom",
        "next-test-api-route-handler",
        "@vitejs/plugin-react",
        "@testing-library/**",
        "@vitest/**"
      ]
    },
    {
      "description": "Group code quality tools",
      "groupName": "Code Quality",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "eslint",
        "typescript",
        "@biomejs/**",
        "@eslint/**",
        "eslint-*",
        "typescript-eslint",
        "@typescript-eslint/**",
        "!eslint-config-next"
      ]
    },
    {
      "description": "Group Tailwind ecosystem",
      "groupName": "Tailwind CSS",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "tailwindcss",
        "@tailwindcss/**"
      ]
    },
    {
      "description": "Group remaining type definitions",
      "groupName": "Type Definitions",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@types/**", "!@types/react", "!@types/react-dom"]
    },
    {
      "description": "Group GitHub Actions updates",
      "groupName": "GitHub Actions",
      "matchManagers": ["github-actions"],
      "schedule": ["* * * * 1"],
      "prPriority": -3,
      "addLabels": ["infrastructure"]
    },
    {
      "description": "Group Docker image updates",
      "groupName": "Docker images",
      "matchManagers": [
        "dockerfile",
        "docker-compose"
      ],
      "schedule": ["* * * * 1"],
      "prPriority": -3,
      "addLabels": ["infrastructure"]
    },
    {
      "description": "Monthly window for infrastructure major upgrades",
      "matchManagers": ["github-actions", "dockerfile", "docker-compose"],
      "matchUpdateTypes": ["major"],
      "schedule": ["* * 1-3 * *"]
    },
    {
      "description": "Dashboard approval only for sensitive major upgrades",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "matchPackageNames": [
        "next",
        "react",
        "react-dom",
        "eslint-config-next",
        "@types/react",
        "@types/react-dom",
        "prisma",
        "@prisma/client",
        "@prisma/adapter-*",
        "@prisma/extension-*",
        "better-auth",
        "@better-auth/**",
        "stripe",
        "@stripe/**"
      ]
    },
    {
      "description": "Keep lockfile maintenance behind dependency fixes",
      "matchUpdateTypes": ["lockFileMaintenance"],
      "prPriority": -3
    }
  ],
  "baseBranchPatterns": ["dev"],
  "automerge": false,
  "dependencyDashboardApproval": false,
  "labels": ["dependencies"],
  "separateMajorMinor": true,
  "separateMinorPatch": true,
  "internalChecksFilter": "strict",
  "prCreation": "immediate",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* * * * 1"],
    "automerge": false,
    "addLabels": ["maintenance"]
  }
}
