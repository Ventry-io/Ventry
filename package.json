{
  "name": "ventry",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.11.1",
  "engines": {
    "node": ">=24 <25"
  },
  "engineStrict": true,
  "scripts": {
    "dev:nossl": "next dev -H 127.0.0.1 -p 3000",
    "dev": "npx concurrently -k --success first --prefix none \"npm:dev:db\" \"npm:dev:wait\"",
    "dev:run": "next dev -H local.dev -p 3443 --experimental-https --experimental-https-key=certs/dev-local-key.pem --experimental-https-cert=certs/dev-local.pem",
    "dev:ventry": "BETTER_AUTH_URL=https://ventry.localhost:3443 NEXTAUTH_URL=https://ventry.localhost:3443 DEV_URL=https://ventry.localhost:3443 next dev -H ventry.localhost -p 3443 --experimental-https --experimental-https-key=certs/dev-local-key.pem --experimental-https-cert=certs/dev-local.pem",
    "dev:wait": "wait-on tcp:127.0.0.1:5433 && npm run dev:ventry",
    "dev:db": "docker compose -f .docker/docker-compose.local.yml up --quiet-pull >/dev/null 2>&1",
    "build": "next build --webpack",
    "build:docker": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "check": "biome check",
    "test": "vitest --run",
    "test:release-notes": "node --test .github/scripts/*.node-test.mjs",
    "test:watch": "vitest --watch",
    "certs:local": "bash scripts/generate-local-certs.sh",
    "certs:local:ca": "bash scripts/generate-local-certs.sh --ca",
    "db:backup": "bash scripts/db-backup.sh",
    "db:restore": "bash scripts/db-restore.sh",
    "db:reset": "bash scripts/db-reset.sh",
    "db:sync": "node scripts/db-sync-overwrite.mjs",
    "db:debug": "tsx scripts/debug-db.ts",
    "db:migrate": "./scripts/prisma-migrate-dev.mjs"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.6.23",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fullcalendar/core": "^6.1.15",
    "@fullcalendar/daygrid": "^6.1.15",
    "@fullcalendar/interaction": "^6.1.15",
    "@fullcalendar/react": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.15",
    "@giphy/js-fetch-api": "^5.8.0",
    "@giphy/js-types": "^5.1.0",
    "@hookform/resolvers": "^5.2.2",
    "@mui/icons-material": "^7.3.4",
    "@mui/material": "^7.3.4",
    "@mui/material-nextjs": "^7.3.9",
    "@mui/x-data-grid": "^8.26.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/extension-accelerate": "^3.0.1",
    "@stripe/connect-js": "^3.3.32",
    "@stripe/react-connect-js": "^3.3.32",
    "@stripe/react-stripe-js": "^5.6.0",
    "@stripe/stripe-js": "^8.7.0",
    "@supabase/supabase-js": "^2.75.0",
    "@types/pg": "^8.20.0",
    "@zxing/browser": "^0.2.0",
    "bcrypt": "^6.0.0",
    "better-auth": "^1.6.23",
    "ioredis": "^5.9.2",
    "jotai": "^2.15.0",
    "jsonwebtoken": "^9.0.2",
    "ky": "^1.11.0",
    "next": "16.2.9",
    "nodemailer": "^8.0.7",
    "pg": "^8.20.0",
    "qr.js": "^0.0.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-easy-crop": "^5.5.6",
    "react-hook-form": "^7.65.0",
    "react-qr-code": "^2.0.21",
    "sharp": "^0.34.5",
    "stripe": "^20.3.0",
    "zod": "^4.1.12",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.5",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.7.2",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sharp": "^0.31.1",
    "@types/zxcvbn": "^4.4.5",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^10.0.3",
    "dotenv": "^17.4.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.4",
    "jsdom": "^26.1.0",
    "next-test-api-route-handler": "^5.0.3",
    "prisma": "^7.6.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5",
    "wait-on": "^9.0.10"
  },
  "overrides": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@giphy/js-util": {
      "uuid": "^11.1.1"
    }
  }
}
