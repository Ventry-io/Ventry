# Shared app settings for every PR preview. Copy to <preview root>/app.env (chmod 600).
# Database, Redis, mail, auth URL and per-preview secrets are set by docker-compose.preview.yml and cannot be overridden here.
# preview.sh refuses to deploy if this file contains live Stripe keys or OAuth client secrets.

# OAuth proxy: Google/GitHub sign-in goes through the staging callback host, which exchanges the code
# and hands the profile back encrypted. Use the same value as OAUTH_PROXY_SECRET on that host (openssl rand -hex 32).
# Never reuse the production BETTER_AUTH_SECRET or any production secret here.
OAUTH_PROXY_SECRET=replace-me
OAUTH_PROXY_PRODUCTION_URL=https://dev.venuva.dog

# Client IDs of the callback host's staging OAuth apps. No client secrets: previews never exchange codes.
GOOGLE_CLIENT_ID=replace-me
GITHUB_CLIENT_ID=replace-me

# Optional: Stripe test mode only (sk_test_/rk_test_). Leave empty to disable payments in previews.
# Do not register preview URLs as Stripe webhook endpoints.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: a dedicated preview Supabase project/bucket. Leave empty to disable uploads in previews.
# Never point previews at the dev or production buckets.
SUPABASE_URL=
SUPABASE_API_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_BUCKET_ID=
SUPABASE_BANNERS_BUCKET_ID=
