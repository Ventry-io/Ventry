generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ProfilePicture {
  id          String    @id @default(cuid())
  userID      String
  signedUrl   String?
  storagePath String
  cachedUntil DateTime?
  isPrimary   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  order       Int       @default(0)
  user        User      @relation(fields: [userID], references: [id], onDelete: Cascade)
}

model User {
  id                   String               @id @default(cuid(2))
  name                 String?              @db.VarChar(255)
  username             String?              @unique @db.VarChar(255)
  email                String               @unique
  bio                  String?
  dateOfBirth          DateTime?
  pronouns             String?
  showAge              Boolean              @default(true)
  showExactBirthdate   Boolean              @default(false)
  socialLinks          Json                 @default("{}")
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  isAdmin              Boolean              @default(false)
  emailVerified        Boolean              @default(false)
  twoFactorEnabled     Boolean              @default(false)
  twoFactorSecret      String?
  twoFactorBackupCodes String?
  image                String?
  country              String?
  legalName            String?
  oauthLegalNameSuggestion String?
  addressLine1         String?
  addressLine2         String?
  addressCity          String?
  addressState         String?
  addressPostalCode    String?
  addressCountry       String?
  adminProfile         Admin?
  payments             Payment[]
  profilePictures      ProfilePicture[]
  registrations        Registration[]
  supportTickets       SupportTicket[]
  accounts             Account[]
  passkeys             Passkey[]
  pendingAccountLinks  PendingAccountLink[]
  sessions             Session[]
  twofactors           TwoFactor[]
  communityPosts       CommunityPost[]
  communityComments    CommunityComment[]
  postReactions        PostReaction[]
  postModerationLogs   PostModerationLog[] @relation("UserPostModerationLogs")
  notifications        Notification[]
  usernameHistory      UsernameHistory[]

  @@map("user")
}

model UsernameHistory {
  id        String   @id @default(cuid())
  username  String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([username, expiresAt])
  @@index([userId])
  @@map("username_history")
}

model Admin {
  id                      String                        @id @default(cuid())
  userId                  String                        @unique
  type                    AdminType                     @default(INDIVIDUAL)
  stripeConnectId         String?
  notes                   String?
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt
  user                    User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkedInRegistrations  Registration[]                @relation("RegistrationCheckedInByAdmin")
  checkInLogs             RegistrationCheckInLog[]
  eventsOwned             Event[]
  history                 RegistrationHistory[]
  supportTicketUpdates    SupportTicket[]               @relation("AdminSupportTicketUpdates")
  postModerationLogs      PostModerationLog[]           @relation("AdminPostModerationLogs")
  organizationsOwned      AdminOrganization[]           @relation("OwnedOrganizations")
  organizationMemberships AdminOrganizationMembership[]
  sentInvitations         AdminInvitation[]             @relation("SentInvitations")
  receivedInvitations     AdminInvitation[]             @relation("ReceivedInvitations")
}

model AdminOrganization {
  id          String                        @id @default(cuid())
  name        String
  slug        String                        @unique
  description String?
  logoUrl     String?
  ownerId     String
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt
  owner       Admin                         @relation("OwnedOrganizations", fields: [ownerId], references: [id])
  members     AdminOrganizationMembership[]
  events      Event[]                       @relation("OrgEvents")
  invitations AdminInvitation[]
  departments CrewDepartment[]
  crewResources Json @default("[]")
}

model AdminOrganizationMembership {
  id             String               @id @default(cuid())
  adminId        String
  organizationId String
  permissions    AdminOrgPermission[]
  accessLevel    CrewAccessLevel @default(WRITE)
  departmentId   String?
  role           String?
  department     CrewDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  joinedAt       DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  admin          Admin                @relation(fields: [adminId], references: [id], onDelete: Cascade)
  organization   AdminOrganization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([adminId, organizationId])
  @@index([organizationId])
}

model AdminInvitation {
  id               String                @id @default(cuid())
  organizationId   String
  invitedEmail     String
  invitedAdminId   String?
  invitedByAdminId String
  permissions      AdminOrgPermission[]
  accessLevel      CrewAccessLevel @default(WRITE)
  departmentId     String?
  role             String?
  department       CrewDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  status           AdminInvitationStatus @default(PENDING)
  token            String                @unique @default(cuid())
  expiresAt        DateTime
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  organization     AdminOrganization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedAdmin     Admin?                @relation("ReceivedInvitations", fields: [invitedAdminId], references: [id])
  invitedByAdmin   Admin                 @relation("SentInvitations", fields: [invitedByAdminId], references: [id])

  @@index([organizationId])
  @@index([token])
  @@index([invitedEmail])
}

model Account {
  id                    String               @id @default(cuid(2))
  userId                String
  accountId             String               @default(cuid(2))
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  PendingAccountLink    PendingAccountLink[]

  @@unique([id, providerId])
  @@map("account")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model Event {
  name                String
  description         String
  startDate           DateTime
  endDate             DateTime
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  imageUrl            String?
  id                  Int             @id @default(autoincrement())
  status              EventStatus     @default(DRAFT)
  stayPolicy          Json            @default("{}")
  ownerId             String?
  customFields        Json            @default("[]")
  maxRegistrations    Int?
  publishAt           DateTime?
  registrationOpensAt DateTime?
  paymentDeadline     DateTime?
  schedule            Json            @default("[]")
  requiresHotel       Boolean         @default(false)
  requireApproval     Boolean         @default(false)
  scanOnce            Boolean         @default(false)
  organizationId      String?
  communityEnabled    Boolean         @default(false)
  communityOpenAfterEnd Boolean       @default(true)
  communityModerated  Boolean         @default(true)
  communityModerateComments Boolean   @default(false)
  communityAttendeesOnly Boolean      @default(true)
  lastDigestSentAt    DateTime?
  badgeTemplates      BadgeTemplate[]
  owner               Admin?          @relation(fields: [ownerId], references: [id])
  organization        AdminOrganization? @relation("OrgEvents", fields: [organizationId], references: [id])
  checkInLogs         RegistrationCheckInLog[]
  location            Location?
  products            Product[]
  registrations       Registration[]
  supportTickets      SupportTicket[]
  communityPosts      CommunityPost[]
}

model CommunityPost {
  id             String              @id @default(cuid())
  eventId        Int
  authorId       String
  type           CommunityPostType
  tags           String[]            @default([])
  content        String?
  imageUrls      String[]            @default([])
  linkUrl        String?
  feedbackRating Int?
  feedbackType   CommunityFeedbackType?
  feedbackEntries Json                @default("[]")
  muxAssetId     String?
  muxPlaybackId  String?
  status         PostStatus          @default(PENDING)
  pinned         Boolean             @default(false)
  deletedAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  event          Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  author         User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reactions      PostReaction[]
  moderationLogs PostModerationLog[]
  comments       CommunityComment[]

  @@index([eventId, status, pinned, createdAt])
  @@index([authorId, createdAt])
}

model CommunityComment {
  id               String        @id @default(cuid())
  postId           String
  authorId         String
  content          String?
  imageUrls        String[]      @default([])
  gifUrl           String?
  mentionedUserIds String[]      @default([])
  status           PostStatus    @default(PENDING)
  deletedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  post             CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author           User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, status, createdAt])
  @@index([authorId, createdAt])
}

model PostReaction {
  id        String        @id @default(cuid())
  postId    String
  userId    String
  reaction  String
  createdAt DateTime      @default(now())
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, reaction])
  @@index([postId])
  @@index([userId])
}

model PostModerationLog {
  id           String           @id @default(cuid())
  postId       String
  actorUserId  String?
  actorAdminId String?
  action       ModerationAction
  reason       String?
  metadata     Json             @default("{}")
  createdAt    DateTime         @default(now())
  post         CommunityPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  actorUser    User?            @relation("UserPostModerationLogs", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorAdmin   Admin?           @relation("AdminPostModerationLogs", fields: [actorAdminId], references: [id], onDelete: SetNull)

  @@index([postId, createdAt])
  @@index([actorUserId])
  @@index([actorAdminId])
}

model BadgeTemplate {
  id         String   @id @default(cuid())
  eventId    Int
  name       String
  isDefault  Boolean  @default(false)
  widthMm    Float    @default(85)
  heightMm   Float    @default(55)
  background Json     @default("{}")
  elements   Json     @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([eventId, isDefault])
}

model Location {
  id         Int      @id @default(autoincrement())
  name       String
  address    String
  city       String
  state      String
  country    String
  postalCode String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  eventId    Int      @unique
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Registration {
  id                String                @id @default(cuid())
  userId            String
  status            RegistrationStatus    @default(PENDING)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  ticketId          Int                   @unique @default(autoincrement())
  eventId           Int
  preferences       Json                  @default("{}")
  customFieldData   Json                  @default("{}")
  expiresAt         DateTime?
  notes             String?
  checkedInAt       DateTime?
  checkedInByAdminId String?
  checkInCount      Int                   @default(0)
  communityNotifications Boolean          @default(true)
  payments          Payment[]
  checkInLogs       RegistrationCheckInLog[]
  checkedInBy       Admin?                @relation("RegistrationCheckedInByAdmin", fields: [checkedInByAdminId], references: [id])
  event             Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  history           RegistrationHistory[]
  registrationItems RegistrationItem[]
  supportTickets    SupportTicket[]
  waitlistEntries   WaitlistEntry[]

  @@unique([userId, eventId])
  @@index([eventId, ticketId])
  @@index([checkedInByAdminId])
}

model RegistrationItem {
  id             String       @id @default(cuid())
  registrationId String
  productId      String
  priceAtBooking Float
  createdAt      DateTime     @default(now())
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
}

model RegistrationHistory {
  id               String       @id @default(cuid())
  registrationId   String
  changedByAdminId String?
  action           String
  changes          Json
  notes            String?
  createdAt        DateTime     @default(now())
  changedBy        Admin?       @relation(fields: [changedByAdminId], references: [id])
  registration     Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
}

model RegistrationCheckInLog {
  id                String       @id @default(cuid())
  registrationId    String?
  eventId           Int
  adminId           String?
  ticketId          Int
  clientOperationId String       @unique
  clientScannedAt   DateTime?
  serverProcessedAt DateTime     @default(now())
  result            String
  notes             Json         @default("{}")
  admin             Admin?       @relation(fields: [adminId], references: [id])
  event             Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration      Registration? @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([eventId, ticketId])
  @@index([registrationId])
  @@index([adminId])
}

model Payment {
  id              String        @id @default(cuid())
  userId          String
  amount          Float
  currency        String
  paymentStatus   PaymentStatus @default(PENDING)
  paymentProvider String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  registrationId  String
  registration    Registration  @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SupportTicket {
  id                   String              @id @default(cuid())
  subject              String
  description          String
  status               SupportTicketStatus @default(OPEN)
  adminResponse        String?
  resolvedAt           DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  eventId              Int
  registrationId       String
  userId               String
  lastUpdatedByAdminId String?
  event                Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  lastUpdatedByAdmin   Admin?              @relation("AdminSupportTicketUpdates", fields: [lastUpdatedByAdminId], references: [id])
  registration         Registration        @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId, status])
  @@index([userId, eventId])
  @@index([registrationId])
}

model Product {
  id                String             @id @default(cuid())
  name              String
  description       String?
  price             Float
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  eventId           Int
  capacity          Int?
  soldCount         Int                @default(0)
  type              ProductType        @default(TICKET)
  allowWaitlist     Boolean            @default(true)
  order             Int                @default(0)
  event             Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrationItems RegistrationItem[]
  waitlistEntries   WaitlistEntry[]
}

model WaitlistEntry {
  id             String       @id @default(cuid())
  registrationId String
  productId      String
  createdAt      DateTime     @default(now())
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([registrationId, productId])
}

model Passkey {
  id           String   @id @default(cuid())
  name         String?
  publicKey    String
  userId       String
  credentialID String   @unique
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime @default(now())
  aaguid       String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("passkey")
}

model PendingAccountLink {
  id                String    @id @default(cuid())
  provider          String
  scope             String?
  accessToken       String?
  confirmedAt       DateTime?
  createdAt         DateTime  @default(now())
  disableEmailLogin Boolean   @default(false)
  emailToken        String?   @unique
  emailTokenSentAt  DateTime?
  emailVerified     Boolean   @default(false)
  expiresAt         DateTime
  idToken           String?
  providerAccountId String
  providerEmail     String
  refreshToken      String?
  tokenExpiresAt    Int?
  tokenType         String?
  userId            String
  accountId         String    @default(cuid(2))
  account           Account   @relation(fields: [accountId, provider], references: [id, providerId], onDelete: Cascade)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([emailToken])
  @@map("pending_account_links")
}

model TwoFactor {
  id          String @id
  secret      String
  backupCodes String
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("twoFactor")
}

enum ProductType {
  TICKET
  ACCOMMODATION
  ADDON
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  APPROVED
  WAITLISTED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum CommunityPostType {
  TEXT
  IMAGE
  LINK
  FEEDBACK
  VIDEO
}

enum CommunityFeedbackType {
  VENUE
  ORGANIZATION
  EVENTS
  OVERALL_EXPERIENCE
}

enum PostStatus {
  PENDING
  APPROVED
  REJECTED
  DELETED
}

enum ModerationAction {
  CREATED
  APPROVED
  REJECTED
  DELETED
  PINNED
  UNPINNED
}

enum AdminType {
  INDIVIDUAL
  ORGANIZATION
}

enum AdminOrgPermission {
  COMMUNITY
  SUPPORT_TICKETS
  EVENT_APPROVAL
  STRIPE_FINANCES
}

enum AdminInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum NotificationType {
  COMMENT
  EVENT
  COMMUNITY
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
}

model CrewDepartment {
  id String @id @default(cuid())
  organizationId String
  name String
  planning String @default("")
  organization AdminOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members AdminOrganizationMembership[]
  invitations AdminInvitation[]
  @@unique([organizationId, name])
}

enum CrewAccessLevel {
  READ
  WRITE
}
